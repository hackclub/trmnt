# Copy to .env for local development. Every variable is described in src/env.ts.

# Matches compose.yaml; start it with `bun run db:start`
DATABASE_URL=postgres://trmnt:trmnt@localhost:5432/trmnt

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

ADMIN_EMAILS=joaquin@hackclub.com,scherejoaquin@gmail.com

# Only when testing through an HTTPS tunnel, e.g. https://printer.osiris-atria.ts.net. Sign in
# through that address too, since the redirect URIs below will use it.
ORIGIN=

# Register at https://auth.hackclub.com/developer/apps with the redirect URI
# http://localhost:5173/auth/hcacallback
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=

# Register under "My OAuth Apps" in Hackatime (confidential, scopes `profile read`) with the
# redirect URI http://localhost:5173/connect/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Postmark sends sign-in codes. Leave these unset locally to have codes printed in the dev
# server's terminal instead. The template gets the `code` and `minutes` variables.
POSTMARK_SERVER_TOKEN=
POSTMARK_SIGN_IN_TEMPLATE=sign-in-code
EMAIL_FROM=
